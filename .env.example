# ICSI: environment variables (placeholders only: never commit real values)

# --- required -------------------------------------------------------------------------------------------
DATABASE_URL=postgres://icsi:icsi-dev-password@localhost:54329/icsi_store
APP_URL=http://localhost:3000
# At least 32 random characters, e.g. `openssl rand -base64 48`. Signs tracking codes and sign-in state.
APP_SECRET=replace-me-with-at-least-32-random-characters

# Set to 1 when your managed PostgreSQL requires TLS (most hosted databases do).
# DATABASE_SSL=1

# --- images ---------------------------------------------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# STORAGE_DRIVER=s3
# S3_BUCKET=icsi-store-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# How many reverse proxies sit in front of the app and append to X-Forwarded-For (almost every host: 1).
# Use 0 if the app is reached directly: the header is then ignored, because anyone can forge it.
# TRUSTED_PROXY_HOPS=1

# --- first owner (optional) -----------------------------------------------------------------------------
# Lets you create the first Owner at /admin/setup. The page closes itself as soon as any administrator exists.
# ADMIN_SETUP_TOKEN=

# --- optional services: each stays OFF until set here AND verified in Admin > Settings ---------------------
# Email (order confirmations, restock alerts, password resets)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0
# EMAIL_FROM="ICSI <store@your-domain.org>"

# Card payments (Stripe Checkout)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Sign in with Google (customers; staff on the Team list)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI writing assistant in the admin
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
